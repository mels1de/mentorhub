# Copy to .env and adjust. Shared by the backend (pydantic Settings) and Docker Compose.

ENVIRONMENT=local
DEBUG=false
# Required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

LOG_LEVEL=INFO
# console (colored, for humans) | json (for containers and log collectors)
LOG_FORMAT=console

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=mentorhub
POSTGRES_PASSWORD=mentorhub
POSTGRES_DB=mentorhub
